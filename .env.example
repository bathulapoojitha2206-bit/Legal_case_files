# ==============================================================================
# Legal Case Files RAG Knowledge Assistant - Environment Configuration
# ==============================================================================

# LLM Provider: 'ollama' (default local), 'openai', or 'groq'
LLM_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT=60.0

# Hugging Face Embeddings Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Chunking & Document Ingestion
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# FAISS Vector Store Storage
FAISS_INDEX_DIR=./faiss_index

# Retrieval Parameters
RETRIEVER_K=4
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional Cloud Deployment Fallbacks (Only needed if deploying to a cloud host without local Ollama)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.2-3b-preview
